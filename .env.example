# Browser-facing application URL. Use http://localhost:3000 locally and the
# canonical production URL on Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Generate separately with the same command. Minimum 32 random bytes.
INTERNAL_API_TOKEN=

# GitHub OAuth App credentials. Never commit real values.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Immutable GitHub user ID allowed to sign in (EMWI2000).
ALLOWED_GITHUB_ID=199608244

# Public FPL entry ID to prefill and sync after the allowed user signs in.
FPL_MANAGER_ID=

# Increment to invalidate every existing stateless session.
SESSION_VERSION=1
